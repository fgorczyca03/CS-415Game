  m_Script: {fileID: 11500000, guid: 2f160da2229de0c4a9108363a078b74b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  playerMovement: {fileID: 1989385764}
  enter: {fileID: 1614031784}
  curtain: {fileID: 1614031778}
  dialogText:
  - 'Father, my mom told me to clean up my room. I ignored her for three days straight.
    I hope I can be forgiven... '
  - 'Father, I''ve made a mistake. My girlfriend of 7 years caught me munching on
    the dog''s treats again. I hope I can be forgiven... '
  - 'Father, I''ve commited sinful acts. I was unfaithful to my husband and he took
    the kids. I hope I can be forgiven... '
  - 'Father, I commited attrocious acts. I am unsure if they are still alive, and
    honestly, I enjoyed the rush. I hope I can be forgiven... '
  - 'Father, I hope to not waste your time with this. It wasn''t really my fault,
    no one told me the building was flammable. I hope I can be forgiven... '
  - Father, I apologize for what I have done. He deserved it. If he hadn't tested
    my patience, maybe he would still be breathing today. I hope I can be forgiven...
  chosenDialog: 0
  textMeshProUGUI: {fileID: 2101908264}
  canvas: {fileID: 2027462201}
  player: {fileID: 1989385763}
  tpLocation: {x: 0.71, y: -2.45, z: -12.5}
  confessionSprite: {fileID: 139117119}
  doorObject: {fileID: 1744386029}
